      "Bearer": {
        "type": "http",
        "description": "ادخل التوكن بتاعك هنا مباشرة (بدون كلمة Bearer)",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ],
  "tags": [
